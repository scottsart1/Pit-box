# Pit Wall engineer runtime: OpenAI only.
# DeepSeek settings from older installations are ignored by the current build.
PITWALL_LLM_PROVIDER=openai
PITWALL_LLM_FALLBACK_PROVIDER=none
OPENAI_API_KEY=replace_me

# Model tiers. PITWALL_MODEL is used only for the deep route (strategy,
# undercut/overcut maths, what-ifs). PITWALL_FAST_MODEL answers ordinary radio
# questions, which are narration of deterministic tool output and do not need
# the flagship tier. The bare "gpt-5.6" alias resolves to Sol, so routing every
# question through it paid frontier prices for a lookup.
#   gpt-5.6-sol   $5.00 / $30.00 per million tokens
#   gpt-5.6-terra $2.00 / $12.00
#   gpt-5.6-luna  $0.20 /  $1.20
PITWALL_MODEL=gpt-5.6-sol
PITWALL_FAST_MODEL=gpt-5.6-luna
PITWALL_TIER_ROUTING_ENABLED=true
PITWALL_REASONING_EFFORT=low
PITWALL_DEEP_REASONING_EFFORT=high
PITWALL_OPENAI_TIMEOUT_S=30
PITWALL_OPENAI_DEEP_MAX_OUTPUT_TOKENS=2200
PITWALL_OPENAI_DEEP_RETRY_MAX_OUTPUT_TOKENS=6000
PITWALL_LLM_FAILURE_COOLDOWN_S=20
PITWALL_LLM_NORMAL_DEADLINE_S=12
PITWALL_LLM_DEEP_DEADLINE_S=25
PITWALL_LLM_SHAKEDOWN_TIMEOUT_S=20
PITWALL_LLM_COMPARE_ENABLED=false
PITWALL_LLM_COMPARE_COOLDOWN_S=30

# Speech-to-speech radio (Realtime API).
# Off by default. When enabled, the wake phrase or L3 opens a live session:
# the engineer can be interrupted mid-sentence, answers without the "stand by"
# acknowledgement, and calls the same telemetry tools. The session is closed
# after a pause because it bills for audio while connected — leaving one open
# for a whole race would be the single largest running cost here.
PITWALL_VOICE_REALTIME_ENABLED=false
PITWALL_REALTIME_MODEL=gpt-realtime-2.1-mini
PITWALL_REALTIME_VOICE=coral
PITWALL_REALTIME_IDLE_TIMEOUT_S=25
PITWALL_REALTIME_MAX_SESSION_S=300
PITWALL_REALTIME_SILENCE_MS=520
PITWALL_REALTIME_NOISE_REDUCTION=near_field
PITWALL_REALTIME_SPEED=1.05

# Voice (file-based fallback pipeline)
PITWALL_STT_MODEL=gpt-4o-mini-transcribe
PITWALL_TTS_MODEL=gpt-4o-mini-tts
PITWALL_VOICE=coral
PITWALL_NATIVE_VOICE=true
# Cached acknowledgement fills the perceived radio vacuum while the engineer
# works; streamed PCM starts speech before the full TTS file exists.
PITWALL_VOICE_ACK_ENABLED=true
PITWALL_VOICE_STREAM_TTS=true
PITWALL_VOICE_CLIP_QUEUE_SIZE=2

# Hands-free wake radio. Say "Mark, what is the target lap?" or say "Mark"
# by itself and speak the command after the local acknowledgement beep.
# Wake matching is prefix-only; L3 / UDP Action 1 remains available unchanged.
PITWALL_WAKE_ENABLED=true
PITWALL_WAKE_PHRASE=mark
PITWALL_WAKE_ALIASES=marc,hey mark,mark radio,hey marc
# Maximum VAD threshold. Pit Wall adapts downward from this ceiling using
# measured room noise; diagnostics show the current live trigger threshold.
PITWALL_WAKE_SPEECH_RMS=180
PITWALL_WAKE_MIN_SPEECH_RMS=75
PITWALL_WAKE_NOISE_MULTIPLIER=1.45
PITWALL_WAKE_NOISE_MARGIN_RMS=18
PITWALL_WAKE_CLIP_MIN_RMS=55
PITWALL_WAKE_SILENCE_S=0.60
PITWALL_WAKE_ARM_TIMEOUT_S=6
PITWALL_WAKE_TTS_COOLDOWN_S=1.50

# Optional microphone device name or numeric index
# PITWALL_AUDIO_DEVICE=

# PS5 UDP
PITWALL_UDP_HOST=0.0.0.0
PITWALL_UDP_PORT=20777
PITWALL_DISCONNECT_AFTER_S=3
PITWALL_OPEN_BROWSER=true

# Keep the existing physical/game mapping: L3 -> UDP Action 1.
# Release normally on L3 button-up. A short audio tail protects the final
# phoneme, while the longer silence fallback tolerates natural pauses.
PITWALL_PTT_RELEASE_MODE=explicit_or_silence
PITWALL_PTT_RELEASE_IGNORE_MS=120
PITWALL_PTT_SILENCE_RELEASE_S=2.20
PITWALL_PTT_SPEECH_RMS=150
PITWALL_PTT_RELEASE_TAIL_S=0.20
PITWALL_PTT_MIN_HOLD_MS=200
PITWALL_PTT_MAX_RECORDING_S=15
PITWALL_PTT_RELEASE_WATCHDOG_S=0

# Proactive engineer
PITWALL_PROACTIVE_ENABLED=true
PITWALL_PROACTIVE_CADENCE_LAPS=2
# Spacing between routine progress calls. Important calls (a rival stopping, a
# battery warning, a tyre limit) use the shorter interval so they are still true
# when spoken; critical calls are not spaced at all.
PITWALL_PROACTIVE_MIN_INTERVAL_S=25
PITWALL_PROACTIVE_IMPORTANT_INTERVAL_S=8
# Unsolicited calls are worded by the model from the deterministic event
# payload. Numbers come only from that payload; on failure or timeout the
# deterministic template is spoken instead, so a call is never lost.
PITWALL_PROACTIVE_NARRATION_ENABLED=true
PITWALL_PROACTIVE_NARRATION_TIMEOUT_S=6

# Housekeeping. 60 Hz lap traces and pre-gating strategy snapshots dominate
# database size; each track's reference lap always keeps its trace.
PITWALL_DB_MAINTENANCE_ON_START=true
PITWALL_DB_KEEP_TRACE_SESSIONS=12
PITWALL_PROACTIVE_SAFE_THROTTLE=0.65
PITWALL_PROACTIVE_MAX_BRAKE=0.15
PITWALL_PROACTIVE_MAX_LATERAL_G=1.35
PITWALL_PROACTIVE_SAFE_HOLD_S=0.45
PITWALL_PROACTIVE_DELIVERY_DEADLINE_S=35
# Safety-car / VSC delta compliance. The call fires when the telemetry delta
# drops below this value; raise it for an earlier, more cautious warning.
PITWALL_PROACTIVE_SC_DELTA_MIN_S=0
PITWALL_PROACTIVE_SC_DELTA_COOLDOWN_S=12

# Diagnostics. Logs are written to %USERPROFILE%\PitWallData\pitwall.log so a
# session can still be investigated after the console window has closed.
PITWALL_LOG_LEVEL=info
PITWALL_LOG_MAX_BYTES=2000000
PITWALL_LOG_BACKUP_COUNT=3

# Engineer personality and radio length
PITWALL_ENGINEER_NAME=Mark
# PITWALL_ENGINEER_PERSONA adds tone/catchphrases without dropping safety rules.
PITWALL_ENGINEER_PERSONA=
# radio_verbosity: terse | standard | chatty
PITWALL_RADIO_VERBOSITY=standard

# Strategy and uncertainty
PITWALL_STRATEGY_MONTE_CARLO_SAMPLES=320
PITWALL_STRATEGY_RISK_QUANTILE=0.75
PITWALL_STRATEGY_MAX_STOPS=3
PITWALL_STRATEGY_COLD_TYRE_PENALTY_S=1.1
PITWALL_STRATEGY_FUEL_SAVE_S_PER_LAP=0.35

# Second-screen / overlay. To view the dashboard or /overlay on a phone or
# tablet on your LAN, bind to all interfaces (only do this on a trusted
# network) and open http://<laptop-ip>:8000 or .../overlay from the device.
# PITWALL_WEB_HOST=0.0.0.0

# Personal-best racing-line map
PITWALL_MAP_DISTANCE_BIN_M=6
PITWALL_MAP_DEVIATION_THRESHOLD_M=1.25
