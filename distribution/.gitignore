# ============================================================================
# NOTHING SECRET LEAVES THIS MACHINE. Verified before every commit.
# ============================================================================

# Private signing key material — NEVER commit. The public key is embedded in
# licensing/keys.py by keygen; only that public value is tracked.
.secrets/
*.ed25519
*_private.pem
*.key
signing_key*

# The code ledger: which codes were minted, used, and redeemed-to-email.
# Local source of truth. Never pushed.
ledger/
*.ledger.json
codes_batch_*.json
codes_batch_*.csv
codes_batch_*.txt

# The sales tracker lists every sellable code, so it is as sensitive as the
# ledger it is generated beside.
activation_keys_*.xlsx

# D1 seed SQL contains the full code list — treat like the ledger.
seed_codes_*.sql

# Packaged build artifacts
build/
distbuild/
*.spec.bak
*.dmg
*.exe
*.msi
__pycache__/
*.pyc
.venv-dist/

# Cloudflare local state. Unanchored: wrangler writes .wrangler/ into whatever
# directory it is invoked from, so `wrangler pages deploy` run from website/
# created a second one that the activation-server-only rule did not cover.
.wrangler/
node_modules/
.dev.vars

# Build-time integrity manifest: generated per build, never source.
# Committing it would make every dev checkout enforce integrity and fail as
# soon as a guarded licensing module is edited.
licensing/integrity_manifest.txt
artifacts/
website/_site/
