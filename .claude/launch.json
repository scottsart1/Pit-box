{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pitwall-dev",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "pitwall.app:app", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "pitwall-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tools.demo_server"],
      "port": 8010
    },
    {
      "name": "pitwall-site",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8020", "--directory", "distribution/website/_site"],
      "port": 8020
    }
  ]
}
